{
  "name": "pdd-order-export",
  "private": true,
  "description": "拼多多订单导出油猴脚本",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "proxy": "vite --mode proxy",
    "build": "vite build && vite build --mode standalone",
    "postbuild": "prettier --write --ignore-path= \"dist/*.js\"",
    "preview": "vite preview",
    "version": "node scripts/version.ts",
    "format": "prettier --write . \"!package-lock.json\"",
    "format:check": "prettier --check . \"!package-lock.json\"",
    "typecheck": "ttsc --noEmit",
    "test": "vitest run && npm run test:browser",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:browser": "playwright test",
    "check": "npm run format:check && npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@ttsc/unplugin": "0.33.1",
    "@types/node": "^24.19.2",
    "@types/papaparse": "5.5.2",
    "acorn": "8.19.0",
    "fflate": "0.8.3",
    "git-describe": "^4.1.1",
    "jsdom": "^26.1.0",
    "lit": "3.3.3",
    "papaparse": "5.7.0",
    "playwright": "^1.64.1",
    "prettier": "^3.6.0",
    "ttsc": "0.33.1",
    "typescript": "7.0.2",
    "typia": "13.3.0",
    "vite": "^8.0.0",
    "vite-plugin-monkey": "^8.1.1",
    "vitest": "^5.0.5",
    "wretch": "3.0.9"
  }
}
